{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GatekeeperAI Canonical Match Contract Schema",
  "version": "v710",
  "type": "object",
  "required": [
    "canonical_id",
    "home_team",
    "away_team",
    "home_clean",
    "away_clean",
    "date_utc",
    "status",
    "competition",
    "schema_version"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "canonical_id": {
      "type": "string",
      "minLength": 1
    },
    "home_team": {
      "type": "string",
      "minLength": 1
    },
    "away_team": {
      "type": "string",
      "minLength": 1
    },
    "home_clean": {
      "type": "string",
      "minLength": 1,
      "description": "Чистое имя команды (snake_case). Числовые значения — легаси-дрифт v9.3, запрещены с 9.6.8-patched (исправление T2/T3 фикстур)."
    },
    "away_clean": {
      "type": "string",
      "minLength": 1,
      "description": "Чистое имя команды (snake_case). Числовые значения — легаси-дрифт v9.3, запрещены с 9.6.8-patched (исправление T2/T3 фикстур)."
    },
    "date_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "completed",
        "postponed",
        "cancelled"
      ]
    },
    "competition": {
      "type": "string"
    },
    "league_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "score": {
      "type": "object",
      "properties": {
        "home": {
          "type": [
            "integer",
            "null"
          ]
        },
        "away": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "odds": {
      "type": "object",
      "description": "Устаревшая вложенная форма (odds.1x2.current.*) — пермиссивна для обратной совместимости. Приоритетный контракт — плоский odds_1x2 на верхнем уровне."
    },
    "odds_1x2": {
      "type": "object",
      "required": [
        "1",
        "X",
        "2"
      ],
      "properties": {
        "1": {
          "type": "number",
          "exclusiveMinimum": 1.0
        },
        "X": {
          "type": "number",
          "exclusiveMinimum": 1.0
        },
        "2": {
          "type": "number",
          "exclusiveMinimum": 1.0
        }
      },
      "additionalProperties": false,
      "description": "Плоская линия 1X2 (контракт патченного моста, T2/T3 фикстур). Десятичные котировки строго больше 1.0: нулевая линия — отсутствие сигнала (CASE_02), а не данные."
    },
    "stats": {
      "type": "object"
    },
    "predictions": {
      "type": "object",
      "description": "Модуль предсказаний заблокирован: поле всегда пустое. Вероятности поставляет core_analysis (см. контракт фикстур)."
    },
    "h2h": {
      "type": "object"
    },
    "value_analysis": {
      "type": "object"
    },
    "core_analysis": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flags": {
      "type": "object",
      "properties": {
        "defensive_collapse": {
          "type": "boolean"
        },
        "critical_missing_players": {
          "type": "boolean"
        }
      }
    },
    "schema_version": {
      "type": "string",
      "const": "v710",
      "description": "Жёсткая отбраковка чужих версий (CASE_04): v700 не проходит по построению контракта, а не только логикой hub."
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "section_history": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
