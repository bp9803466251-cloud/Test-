{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatekeeperAI Match Object v710",
  "description": "Канонический формат матча GatekeeperAI (schema v710, §19.1)",
  "type": "object",
  "required": [
    "canonical_id",
    "home_team",
    "away_team",
    "home_clean",
    "away_clean",
    "competition",
    "country",
    "date_utc",
    "status",
    "version",
    "schema_version",
    "odds",
    "source_ids",
    "sources",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "canonical_id": {
      "type": "string",
      "description": "{home_clean}__{away_clean}__{YYYYMMDD}",
      "pattern": "^[a-z0-9_]+__[a-z0-9_]+__\\d{8}$"
    },
    "home_team": {
      "type": "string",
      "description": "Оригинальное название домашней команды"
    },
    "away_team": {
      "type": "string",
      "description": "Оригинальное название гостевой команды"
    },
    "home_clean": {
      "type": "string",
      "description": "Нормализованное название (через clean_team_name)",
      "minLength": 1
    },
    "away_clean": {
      "type": "string",
      "description": "Нормализованное название (через clean_team_name)",
      "minLength": 1
    },
    "competition": {
      "type": "string",
      "description": "Название лиги/турнира (строка, не dict) — §1.18"
    },
    "country": {
      "type": "string",
      "description": "Страна"
    },
    "date_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC — единственный источник даты (§1.18)"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "completed",
        "cancelled",
        "postponed",
        "interrupted",
        "archived"
      ],
      "description": "Статус матча (state machine §24.1)"
    },
    "score": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "home": {
          "type": [
            "integer",
            "null"
          ]
        },
        "away": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "description": "Плоский счёт {home: int, away: int} — §1.18",
      "required": [
        "home",
        "away"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "CAS-версия (инкрементируется при patch_match)"
    },
    "schema_version": {
      "type": "string",
      "const": "v710",
      "description": "Версия схемы — gatekeeper для миграций (§20.8)"
    },
    "odds": {
      "type": [
        "object",
        "null"
      ],
      "description": "Коэффициенты в формате 1x2 (§1.21)",
      "properties": {
        "1x2": {
          "type": "object",
          "properties": {
            "current": {
              "type": "object",
              "description": "Текущие коэффициенты {home, draw, away} — float"
            },
            "opening": {
              "type": "object",
              "description": "Открытые коэффициенты {home, draw, away} — float"
            },
            "best": {
              "type": "object",
              "description": "Лучшие коэффициенты {home, draw, away} — float"
            },
            "closing": {
              "type": "object",
              "description": "Закрытые коэффициенты {home, draw, away} — float"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "upstream": {
                    "type": "string"
                  },
                  "price": {
                    "type": "object"
                  },
                  "timestamp": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": [
                  "source",
                  "price"
                ]
              },
              "description": "История источников коэффициентов"
            }
          }
        }
      }
    },
    "predictions": {
      "type": "object",
      "description": "Прогнозы: {source, home_win, draw, away_win} — top-level секция (§8.5)"
    },
    "stats": {
      "type": "object",
      "description": "Статистика матча (от Bzzoiro)"
    },
    "h2h": {
      "type": "object",
      "description": "Head-to-head (от Bzzoiro)"
    },
    "source_ids": {
      "type": "object",
      "description": "ID матча в источнике {source: id} — §1.26",
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_map": {
      "type": "object",
      "description": "Карта источников для history-матчей"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Уникальные источники данных (список) — §1.28",
      "uniqueItems": true,
      "minItems": 1
    },
    "section_history": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "upstream": {
            "type": "string"
          }
        },
        "required": [
          "section",
          "source",
          "updated_at",
          "upstream"
        ]
      },
      "description": "FIFO-буфер, не более 20 записей (§19.1)"
    },
    "value_analysis": {
      "type": "object",
      "description": "Результат value-анализа ({} до расчёта) — §8"
    },
    "time_utc": {
      "type": [
        "string",
        "null"
      ],
      "description": "Время начала (HH:MM), доп. к date_utc"
    },
    "csv_raw": {
      "type": "object",
      "description": "Сырые колонки CSV (для history) — §8.5"
    },
    "flags": {
      "type": "object",
      "description": "Системные флаги"
    },
    "half_time_score": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "home": {
          "type": [
            "integer",
            "null"
          ]
        },
        "away": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "description": "Счёт первого тайма"
    },
    "full_time_result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "H",
        "D",
        "A",
        null
      ],
      "description": "Результат: H (home), D (draw), A (away)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 MSK — время создания"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 MSK — время последнего обновления"
    },
    "season": {
      "type": "string",
      "description": "Сезон (для history, напр. '2526')"
    },
    "league_code": {
      "type": "string",
      "description": "Код лиги (для history, напр. 'E0')"
    }
  },
  "additionalProperties": true
}
