{
  "version": "v710",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GatekeeperAI Match Schema v710",
  "type": "object",
  "required": [
    "canonical_id",
    "home_team",
    "away_team",
    "home_clean",
    "away_clean",
    "competition",
    "country",
    "date_utc",
    "status",
    "version",
    "schema_version"
  ],
  "properties": {
    "canonical_id": {
      "type": "string",
      "minLength": 1
    },
    "home_team": {
      "type": "string",
      "minLength": 1
    },
    "away_team": {
      "type": "string",
      "minLength": 1
    },
    "home_clean": {
      "type": "string",
      "minLength": 1
    },
    "away_clean": {
      "type": "string",
      "minLength": 1
    },
    "competition": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "date_utc": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "completed"
      ]
    },
    "score": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "home": {
          "type": [
            "integer",
            "string"
          ]
        },
        "away": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "v710"
      ]
    },
    "odds": {
      "type": "object"
    },
    "predictions": {
      "type": "object"
    },
    "stats": {
      "type": "object"
    },
    "h2h": {
      "type": "object"
    },
    "source_ids": {
      "type": "object"
    },
    "source_map": {
      "type": "object"
    },
    "flags": {
      "type": "object"
    },
    "half_time_score": {
      "type": [
        "object",
        "null"
      ]
    },
    "full_time_result": {
      "type": [
        "string",
        "null"
      ]
    },
    "referee": {
      "type": [
        "string",
        "null"
      ]
    },
    "season": {
      "type": "string"
    },
    "league_code": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "section_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      }
    },
    "value_analysis": {
      "type": "object"
    },
    "time_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "csv_raw": {
      "type": "object"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
