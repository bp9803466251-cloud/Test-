{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "version": "7.10",
    "type": "object",
    "required": [
        "id",
        "sources",
        "source",
        "home",
        "away",
        "date_utc",
        "odds"
    ],
    "properties": {
        "id": {
            "type": "string",
            "description": "Canonical ID: home__away__YYYYMMDD",
            "pattern": "^[a-z0-9_]+__[a-z0-9_]+__[0-9]{8}$"
        },
        "sources": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "source": {
            "type": "string",
            "enum": [
                "sharpapi",
                "odds_api",
                "propline",
                "bzzoiro",
                "football_data"
            ]
        },
        "home": {
            "type": "string",
            "minLength": 1
        },
        "away": {
            "type": "string",
            "minLength": 1
        },
        "date_utc": {
            "type": "string",
            "format": "date-time"
        },
        "status": {
            "type": "string",
            "enum": [
                "scheduled",
                "live",
                "completed",
                "cancelled",
                "postponed",
                "interrupted",
                "archived"
            ],
            "default": "scheduled"
        },
        "score": {
            "type": "object",
            "properties": {
                "home": {
                    "type": "integer",
                    "minimum": 0
                },
                "away": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "competition": {
            "type": "string",
            "minLength": 1
        },
        "country": {
            "type": "string",
            "minLength": 1
        },
        "odds": {
            "type": "object",
            "required": [
                "open"
            ],
            "properties": {
                "open": {
                    "type": "object",
                    "required": [
                        "home",
                        "draw",
                        "away"
                    ],
                    "properties": {
                        "home": {
                            "type": "number",
                            "minimum": 1.0
                        },
                        "draw": {
                            "type": "number",
                            "minimum": 1.0
                        },
                        "away": {
                            "type": "number",
                            "minimum": 1.0
                        }
                    }
                },
                "closing": {
                    "type": "object",
                    "properties": {
                        "home": {
                            "type": "number",
                            "minimum": 1.0
                        },
                        "draw": {
                            "type": "number",
                            "minimum": 1.0
                        },
                        "away": {
                            "type": "number",
                            "minimum": 1.0
                        }
                    }
                }
            }
        },
        "metadata": {
            "type": "object",
            "properties": {
                "fetched_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "canonical_verified": {
                    "type": "boolean"
                },
                "upstream": {
                    "type": "string"
                }
            }
        }
    },
    "additionalProperties": true
}
