{
  "$schema": "http://json-schema.org",
  "title": "GatekeeperAI Canonical Match Contract Schema",
  "version": "v710",
  "type": "object",
  "required": [
    "canonical_id",
    "home_team",
    "away_team",
    "home_clean",
    "away_clean",
    "date_utc",
    "status",
    "competition",
    "schema_version"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "canonical_id": {
      "type": "string",
      "minLength": 1
    },
    "home_team": {
      "type": "string",
      "minLength": 1
    },
    "away_team": {
      "type": "string",
      "minLength": 1
    },
    "home_clean": {
      "type": ["string", "number"],
      "minLength": 1
    },
    "away_clean": {
      "type": ["string", "number"],
      "minLength": 1
    },
    "date_utc": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "completed",
        "postponed",
        "cancelled"
      ]
    },
    "competition": {
      "type": "string"
    },
    "league_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "score": {
      "type": "object",
      "properties": {
        "home": {
          "type": ["integer", "null"]
        },
        "away": {
          "type": ["integer", "null"]
        }
      }
    },
    "odds": {
      "type": "object"
    },
    "stats": {
      "type": "object"
    },
    "predictions": {
      "type": "object"
    },
    "h2h": {
      "type": "object"
    },
    "value_analysis": {
      "type": "object"
    },
    "core_analysis": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "section_history": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
