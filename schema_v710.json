{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatekeeperAI Match Object v710",
  "description": "Канонический формат матча GatekeeperAI (schema v710, §19.1)",
  "type": "object",
  "required": [
    "canonical_id",
    "home_team",
    "away_team",
    "home_clean",
    "away_clean",
    "competition",
    "country",
    "date_utc",
    "status",
    "version",
    "schema_version",
    "odds",
    "source_ids",
    "sources",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "canonical_id": {
      "type": "string",
      "description": "{home_clean}__{away_clean}__{YYYYMMDD}",
      "pattern": "^[a-z0-9_]+__[a-z0-9_]+__\\d{8}$"
    },
    "home_team": {
      "type": "string",
      "description": "Оригинальное название домашней команды"
    },
    "away_team": {
      "type": "string",
      "description": "Оригинальное название гостевой команды"
    },
    "home_clean": {
      "type": "string",
      "minLength": 1,
      "description": "Нормализованное название"
    },
    "away_clean": {
      "type": "string",
      "minLength": 1,
      "description": "Нормализованное название"
    },
    "competition": {
      "type": "string",
      "description": "Название лиги/турнира (строка, не dict) — §1.18"
    },
    "country": {
      "type": "string",
      "description": "Страна"
    },
    "date_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "completed",
        "cancelled",
        "postponed",
        "interrupted",
        "archived"
      ],
      "description": "Статус матча"
    },
    "score": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "home": {
          "type": [
            "integer",
            "null"
          ]
        },
        "away": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "home",
        "away"
      ],
      "description": "Плоский счёт"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "CAS-версия"
    },
    "schema_version": {
      "type": "string",
      "const": "v710",
      "description": "Версия схемы"
    },
    "odds": {
      "type": [
        "object",
        "null"
      ],
      "description": "Коэффициенты",
      "properties": {
        "1x2": {
          "type": "object",
          "properties": {
            "current": {
              "type": "object"
            },
            "opening": {
              "type": "object"
            },
            "best": {
              "type": "object"
            },
            "closing": {
              "type": "object"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "upstream": {
                    "type": "string"
                  },
                  "price": {
                    "type": "object"
                  },
                  "timestamp": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": [
                  "source",
                  "price"
                ]
              }
            }
          }
        }
      }
    },
    "predictions": {
      "type": "object",
      "description": "Прогнозы"
    },
    "stats": {
      "type": "object",
      "description": "Статистика матча"
    },
    "h2h": {
      "type": "object",
      "description": "Head-to-head"
    },
    "source_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "ID матча в источнике"
    },
    "source_map": {
      "type": "object",
      "description": "Карта источников"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Источники данных"
    },
    "section_history": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "upstream": {
            "type": "string"
          }
        },
        "required": [
          "section",
          "source",
          "updated_at",
          "upstream"
        ]
      },
      "description": "FIFO-буфер"
    },
    "value_analysis": {
      "type": "object",
      "description": "Результат value-анализа"
    },
    "time_utc": {
      "type": [
        "string",
        "null"
      ],
      "description": "Время начала"
    },
    "csv_raw": {
      "type": "object",
      "description": "Сырые колонки CSV"
    },
    "flags": {
      "type": "object",
      "description": "Системные флаги"
    },
    "half_time_score": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "home": {
          "type": [
            "integer",
            "null"
          ]
        },
        "away": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "description": "Счёт первого тайма"
    },
    "full_time_result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "H",
        "D",
        "A",
        null
      ],
      "description": "Результат"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 MSK"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 MSK"
    },
    "season": {
      "type": "string",
      "description": "Сезон"
    },
    "league_code": {
      "type": "string",
      "description": "Код лиги"
    }
  },
  "additionalProperties": true
}